// One-time import of the callbacks note into SQL.
//
//   node scripts/import-callbacks.mts data/callbacks.txt > data/import_callbacks.sql
//
// Each line is "<company> <kind>[: <m/d>] — <debrief>". The debrief is everything
// after the dash, byte for byte. Score is read from the debrief's leading "508/600".
// Nothing is guessed: unknown dates and outcomes stay null, and no application rows
// are created or linked.

import { readFileSync } from "node:fs";

const YEAR = 2026;

const src = process.argv[2];
if (!src) {
  console.error("usage: node scripts/import-callbacks.mts <notes file>");
  process.exit(1);
}

// Company names as the owner writes them, mapped to how they're stored.
// kind: CodeSignal is the OA platform, so both CodeSignal lines are OAs.
// outcome: only what the owner stated outright.
const KNOWN: Record<string, { company: string; kind: string; outcome: string | null }> = {
  "Tiktok Codesignal": { company: "TikTok", kind: "OA", outcome: null },
  "Capital One CodeSignal": { company: "Capital One", kind: "OA", outcome: "Rejected" },
  "Scale AI OA": { company: "Scale AI", kind: "OA", outcome: null },
};

const LINE = /^(.+?)(?::\s*(\d{1,2})\/(\d{1,2}))?\s+—\s+(.+)$/;

type Row = { date: string | null; company: string; kind: string; score: string | null; outcome: string | null; debrief: string };
const rows: Row[] = [];
const problems: string[] = [];

for (const raw of readFileSync(src, "utf8").split("\n")) {
  const m = raw.match(LINE);
  if (!m) continue;
  const head = m[1].trim();
  const known = KNOWN[head];
  if (!known) {
    problems.push(`unrecognized callback line: ${head}`);
    continue;
  }
  const debrief = m[4];
  rows.push({
    date: m[2] ? `${YEAR}-${m[2].padStart(2, "0")}-${m[3].padStart(2, "0")}` : null,
    ...known,
    score: debrief.match(/^(\d+\/\d+)\b/)?.[1] ?? null,
    debrief,
  });
}

if (rows.length !== Object.keys(KNOWN).length) problems.push(`expected ${Object.keys(KNOWN).length} callbacks, parsed ${rows.length}`);
if (problems.length) {
  console.error(`${problems.length} problem(s):\n- ${problems.join("\n- ")}`);
  process.exit(1);
}
for (const r of rows) console.error(`${r.company} ${r.kind}  date=${r.date ?? "-"}  score=${r.score ?? "-"}  outcome=${r.outcome ?? "-"}`);

const q = (s: string | null) => (s === null ? "null" : `'${s.replaceAll("'", "''")}'`);

process.stdout.write(`-- Generated by scripts/import-callbacks.mts from ${src}. Review before applying.
-- ${rows.length} callbacks. Debriefs are verbatim. No applications are created or linked.
-- Runs as one transaction and refuses to run if callbacks already has rows.

begin;

do $$
begin
  if exists (select 1 from public.callbacks) then
    raise exception 'callbacks is not empty; import already ran or data exists';
  end if;
end $$;

insert into public.callbacks (logical_date, company, kind, score, outcome, debrief) values
${rows.map((r) => `  (${q(r.date)}, ${q(r.company)}, ${q(r.kind)}, ${q(r.score)}, ${q(r.outcome)}, ${q(r.debrief)})`).join(",\n")};

commit;
`);
