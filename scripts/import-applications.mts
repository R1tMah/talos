// One-time import of the "New Grad Applications" sheet into SQL.
//
//   node scripts/import-applications.mts data/applications.tsv > data/import_applications.sql
//   node scripts/import-applications.mts data/applications.tsv --migration > supabase/migrations/<ts>_import_applications.sql
//
// With --migration the explicit begin/commit is left out, since `supabase db push`
// already runs each migration in its own transaction.
// Reads a TSV transcription of the sheet (company, date, position, status, resume),
// prints a validation report to stderr, and writes a single-transaction SQL file
// to stdout. Nothing touches the database; the owner reviews the SQL and applies it.
// Values are kept exactly as written in the sheet, typos included.

import { readFileSync } from "node:fs";

const YEAR = 2026;
const STATUSES = ["Applied", "OA Stage", "Rejected"];

const src = process.argv[2];
const asMigration = process.argv.includes("--migration");
if (!src) {
  console.error("usage: node scripts/import-applications.mts <tsv file>");
  process.exit(1);
}

const [header, ...lines] = readFileSync(src, "utf8").split("\n").filter((l) => l.trim() !== "");
const problems: string[] = [];
if (header !== "company\tdate\tposition\tstatus\tresume") problems.push(`unexpected header: ${header}`);

type App = { company: string; date: string; position: string; status: string; resume: string | null };

const apps: App[] = lines.map((line, i) => {
  const row = i + 2;
  const cols = line.split("\t");
  if (cols.length !== 5) problems.push(`row ${row}: expected 5 columns, got ${cols.length}`);
  const [company = "", md = "", position = "", status = "", resume = ""] = cols;

  const m = md.match(/^(\d{1,2})\/(\d{1,2})$/);
  let date = "";
  if (!m) problems.push(`row ${row}: bad date "${md}"`);
  else {
    const [mo, d] = [+m[1], +m[2]];
    const t = new Date(Date.UTC(YEAR, mo - 1, d));
    if (t.getUTCMonth() !== mo - 1 || t.getUTCDate() !== d) problems.push(`row ${row}: impossible date "${md}"`);
    date = `${YEAR}-${String(mo).padStart(2, "0")}-${String(d).padStart(2, "0")}`;
  }

  if (!company) problems.push(`row ${row}: missing company`);
  if (!position) problems.push(`row ${row}: missing position`);
  if (!STATUSES.includes(status)) problems.push(`row ${row}: unknown status "${status}"`);
  return { company, date, position, status, resume: resume === "" ? null : resume };
});

// Exact duplicates are almost certainly transcription mistakes; same company twice is normal.
const seen = new Set<string>();
for (const a of apps) {
  const k = `${a.company}|${a.date}|${a.position}`;
  if (seen.has(k)) problems.push(`duplicate row: ${a.company}, ${a.date}, ${a.position}`);
  seen.add(k);
}

const today = new Date().toISOString().slice(0, 10);
for (const a of apps) if (a.date > today) problems.push(`future date: ${a.company} ${a.date}`);

// ---- Report ----------------------------------------------------------------

const dates = apps.map((a) => a.date).sort();
const count = (f: (a: App) => boolean) => apps.filter(f).length;
console.error(`${apps.length} applications, ${dates[0]} to ${dates.at(-1)}`);
for (const s of STATUSES) console.error(`  ${s}: ${count((a) => a.status === s)}`);
console.error(`  no resume: ${count((a) => a.resume === null)}`);
const repeats = Object.entries(Object.groupBy(apps, (a) => a.company)).filter(([, v]) => v!.length > 1);
for (const [c, v] of repeats) console.error(`  ${c} x${v!.length}: ${v!.map((a) => `${a.date} ${a.position} (${a.status})`).join("; ")}`);
if (problems.length) {
  console.error(`\n${problems.length} problem(s):\n- ${problems.join("\n- ")}`);
  process.exit(1);
}
console.error("\nall checks passed");

// ---- SQL -------------------------------------------------------------------

const q = (s: string | null) => (s === null ? "null" : `'${s.replaceAll("'", "''")}'`);

const sql = `-- Generated by scripts/import-applications.mts from ${src}. Review before applying.
-- ${apps.length} applications (${dates[0]} to ${dates.at(-1)}), values exactly as in the sheet.
-- Runs as one transaction and refuses to run if applications already has rows.
${asMigration ? "" : "\nbegin;\n"}
do $$
begin
  if exists (select 1 from public.applications) then
    raise exception 'applications is not empty; import already ran or data exists';
  end if;
end $$;

insert into public.applications (company, applied_date, position, status, resume_name) values
${apps.map((a) => `  (${q(a.company)}, ${q(a.date)}, ${q(a.position)}, ${q(a.status)}, ${q(a.resume)})`).join(",\n")};
${asMigration ? "" : "\ncommit;\n"}`;
process.stdout.write(sql);
